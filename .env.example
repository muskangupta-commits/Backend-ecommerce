# Copy this file to .env, then replace TOKEN_ENCRYPTION_KEY with a generated key.
# Generate a key with: py -c "import secrets; print(secrets.token_hex(32))"
API_V1_PREFIX=/api/v1
APP_NAME=Cartify E-Commerce API
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:5173

# Use a local MongoDB instance or replace with your private Atlas URI.
MONGODB_URI=mongodb://localhost:27017/ecommerce_db
MONGODB_DATABASE=ecommerce_db

# Required: 32 random bytes encoded as 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY=
TOKEN_EXPIRE_DAYS=7

# Development only. No OTP delivery provider is configured.
DEMO_OTP=123456
DEMO_OTP_ENABLED=true

# Optional. Use Stripe test keys for local payment testing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
